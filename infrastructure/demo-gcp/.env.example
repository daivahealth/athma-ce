# Copy to .env on the VM and fill in. Generate secrets with:
#   openssl rand -hex 32          (passwords, JWT secrets, internal key)
#   openssl rand -base64 32       (SECRETS_MASTER_KEY - must be base64 of 32 bytes)
# A daiva.health subdomain (needs DNS records, see the runbook) or <ip-with-dashes>.sslip.io
DEMO_DOMAIN=athma-ce-demo.daiva.health
# Frontend deployment mode (banner + disclaimer); demo when unset. Rebuild the frontend after changing it.
# DEPLOYMENT_MODE=demo
# Login page email form: collapsed by default in demo mode (behind "Staff sign-in with email"). Rebuild the frontend after changing it.
# LOGIN_EMAIL=visible
# Public landing page at /: on by default in demo mode. Rebuild the frontend after changing it.
# LANDING_PAGE=off
POSTGRES_PASSWORD=
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_RESET_SECRET=
INTERNAL_API_KEY=
# Writes need a valid JWT or the internal key; true when unset. Set false only to debug.
# AUTH_REQUIRE_TOKEN_FOR_WRITES=true

# External sign-in (see the runbook, "Social sign-in"). Leave a pair empty to hide that button.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
# Google accounts that sign in as platform admin (super_admin + tenant_admin), comma-separated
OAUTH_PLATFORM_ADMINS=google:you@example.com
SECRETS_MASTER_KEY=

# Optional - AI features
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
