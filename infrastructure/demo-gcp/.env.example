# Copy to .env on the VM and fill in. Generate secrets with:
#   openssl rand -hex 32          (passwords, JWT secrets, internal key)
#   openssl rand -base64 32       (SECRETS_MASTER_KEY - must be base64 of 32 bytes)
DEMO_DOMAIN=34-100-1-2.sslip.io
POSTGRES_PASSWORD=
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_RESET_SECRET=
INTERNAL_API_KEY=
SECRETS_MASTER_KEY=

# Optional - AI features
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
