# One image for every backend service (foundation, clinical, rcm, prm,
# ai-gateway, abdm-connector). docker-compose.yml picks the service by command.
# Build context: repository root.
FROM node:22-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY backend/ backend/
COPY plugins/ plugins/

RUN cd backend && npm ci --no-audit --no-fund
# Turbo does not order builds by "file:" workspace deps, so build the leaf
# shared packages first, then everything else.
RUN cd backend \
  && npx turbo run build --filter=./contracts --filter=./shared/types \
  && npx turbo run build --filter=./shared/utils \
  && npx turbo run build --filter=./shared/observability --filter=./shared/config-client \
       --filter=./shared/validators --filter=./shared/plugin-sdk \
  && npx turbo run build
# Fail the build if a shared package's "main" was not emitted where
# package.json says (e.g. tsc nesting output under dist/shared/<pkg>/src).
RUN cd backend && for d in shared/* contracts; do \
      node -e "const p=require('./$d/package.json'); if (p.main && !require('fs').existsSync('$d/'+p.main)) { console.error('missing $d/'+p.main); process.exit(1) }" || exit 1; \
    done

# Oncology plugin: its own Prisma client, loaded by clinical at runtime.
RUN cd plugins/oncology && npm ci --no-audit --no-fund \
  && npx prisma generate --schema backend/prisma/schema.prisma

ENV NODE_ENV=production
WORKDIR /app/backend
