# Automatic HTTPS (Let's Encrypt) for each public hostname.
# DEMO_DOMAIN is e.g. athma-ce-demo.daiva.health or 34-100-1-2.sslip.io; the APIs
# live on its subdomains. SITE_DOMAIN is the public address of the web app
# (e.g. athma.daiva.health); it defaults to DEMO_DOMAIN. The web app answers on
# SITE_DOMAIN, and DEMO_DOMAIN / app.DEMO_DOMAIN redirect there, so every visitor
# uses one address (one browser session, one sign-in return URL).
{$SITE_DOMAIN}, {$DEMO_DOMAIN}, app.{$DEMO_DOMAIN} {
	@other not host {$SITE_DOMAIN}
	redir @other https://{$SITE_DOMAIN}{uri} 308
	encode gzip
	reverse_proxy frontend:3000
}

foundation.{$DEMO_DOMAIN} {
	reverse_proxy foundation:3010
}

clinical.{$DEMO_DOMAIN} {
	request_body {
		max_size 50MB
	}
	reverse_proxy clinical:3011
}

rcm.{$DEMO_DOMAIN} {
	reverse_proxy rcm:3012
}

prm.{$DEMO_DOMAIN} {
	reverse_proxy prm:3013
}

ai.{$DEMO_DOMAIN} {
	reverse_proxy ai-gateway:3015
}
