# Next.js frontend. NEXT_PUBLIC_* values are baked in at build time, so the
# image must be rebuilt when the public hostnames change.
# Build context: repository root. The repo layout is kept (frontend/ next to
# backend/contracts/) because the frontend imports contract types by relative path.
FROM node:22-bookworm-slim

WORKDIR /app/frontend

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY backend/contracts/src /app/backend/contracts/src
COPY frontend/ ./

ARG NEXT_PUBLIC_FOUNDATION_BASE_URL
ARG NEXT_PUBLIC_CLINICAL_BASE_URL
ARG NEXT_PUBLIC_RCM_BASE_URL
ARG NEXT_PUBLIC_RCM_CLAIMS_BASE_URL
ARG NEXT_PUBLIC_PRM_BASE_URL
ARG NEXT_PUBLIC_AI_GATEWAY_BASE_URL
ARG NEXT_PUBLIC_AUTH_BASE_URL
ENV NEXT_PUBLIC_OBSERVABILITY_ENABLED=false \
    NEXT_PUBLIC_DEBUG_API=false \
    NEXT_TELEMETRY_DISABLED=1

RUN NODE_OPTIONS=--max-old-space-size=3072 npm run build

ENV NODE_ENV=production
EXPOSE 3000
CMD ["npx", "next", "start", "-p", "3000"]
