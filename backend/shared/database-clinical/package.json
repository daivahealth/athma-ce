{
  "name": "@zeal/database-clinical",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "prisma generate --schema prisma/schema.prisma && tsc -p tsconfig.build.json",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@zeal/observability": "file:../observability",
    "@zeal/shared-utils": "file:../utils"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "prisma": "^6.19.0",
    "typescript": "^5.3.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "diagnostics": false
        }
      ]
    }
  }
}
