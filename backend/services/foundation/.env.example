# Copy to .env.local before running this service:
#   cp services/foundation/.env.example services/foundation/.env.local

# Server
NODE_ENV=development
PORT=3010
LOG_LEVEL=debug

# Database
FOUNDATION_DATABASE_URL="postgresql://zeal_user:zeal_password@localhost:5432/zeal_foundation?schema=public"

# Auth
# JWT_SECRET must be IDENTICAL in foundation and rcm, or tokens minted by one
# are rejected by the other with "JsonWebTokenError: invalid signature".
JWT_SECRET=local-dev-jwt-secret-change-in-production
JWT_EXPIRATION="1h"

# Service-to-service auth
# INTERNAL_API_KEY must be IDENTICAL in foundation and clinical.
INTERNAL_API_KEY=local-dev-internal-api-key
