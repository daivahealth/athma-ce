# Copy to .env.local before running this service:
#   cp services/clinical/.env.example services/clinical/.env.local

# Server
NODE_ENV=development
PORT=3011

# Database
CLINICAL_DATABASE_URL=postgresql://zeal_user:zeal_password@localhost:5432/zeal_clinical?schema=public

# Upstream services
FOUNDATION_API_URL=http://localhost:3010/api/v1
CONFIG_API_URL=http://localhost:3010/configs
CONFIG_CACHE_TTL=300000

# Service-to-service auth
# INTERNAL_API_KEY must be IDENTICAL in foundation and clinical.
INTERNAL_API_KEY=local-dev-internal-api-key
