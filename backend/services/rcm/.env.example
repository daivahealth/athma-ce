# Copy to .env.local before running this service:
#   cp services/rcm/.env.example services/rcm/.env.local

# Server
NODE_ENV=development
PORT=3012

# Database
RCM_DATABASE_URL=postgresql://zeal_user:zeal_password@localhost:5432/zeal_rcm?schema=public

# Upstream services
CLINICAL_API_URL=http://localhost:3011
FOUNDATION_API_URL=http://localhost:3010/api/v1

# Auth
# JWT_SECRET must be IDENTICAL in foundation and rcm.
JWT_SECRET=local-dev-jwt-secret-change-in-production
