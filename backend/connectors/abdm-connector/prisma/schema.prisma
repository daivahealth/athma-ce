// ABDM connector database (zeal_abdm): protocol state only — correlation of
// async gateway transactions to tenants, HIP↔facility routing, and the
// quarantine of unresolvable callbacks. PHI never lives here; clinical data
// stays in the clinical service and is fetched per use (ADR-0015).

generator client {
  provider = "prisma-client-js"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
  url      = env("ABDM_DATABASE_URL")
}

/// Every outbound async gateway request records its transaction here BEFORE
/// leaving, so the later callback can be routed to the right tenant. This is
/// the only place callbacks may resolve tenancy from — never the payload.
model CorrelationEntry {
  id          String    @id @default(uuid()) @map("id") @db.Uuid
  /// ABDM request/transaction id used to correlate the callback.
  txnId       String    @unique @map("txn_id")
  /// Workflow this transaction belongs to, e.g. 'abha.enrol', 'abha.verify'.
  flow        String    @map("flow")
  tenantId    String    @map("tenant_id") @db.Uuid
  facilityId  String?   @map("facility_id") @db.Uuid
  status      String    @default("pending") @map("status") // pending | completed | failed | expired
  /// Non-sensitive routing context only — never OTPs, tokens, or identifiers.
  metadata    Json?     @map("metadata")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  @@index([tenantId, flow])
  @@index([expiresAt])
  @@map("correlation_entries")
}

/// Routes gateway-initiated flows (discovery, consent notifications) that
/// carry a HIP id instead of a transaction id. Each facility is its own HIP
/// in ABDM's HRP model; the mapping is maintained via the internal API when
/// a facility is onboarded (HFR linking, issue #96+).
model HipFacilityMapping {
  id         String   @id @default(uuid()) @map("id") @db.Uuid
  hipId      String   @unique @map("hip_id")
  tenantId   String   @map("tenant_id") @db.Uuid
  facilityId String   @map("facility_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId])
  @@map("hip_facility_mappings")
}

/// Callbacks that could not be verified or resolved to a tenant. Never
/// processed, never guessed — held for operator triage (see the ABDM
/// connector runbook).
model QuarantinedCallback {
  id         String    @id @default(uuid()) @map("id") @db.Uuid
  path       String    @map("path")
  reason     String    @map("reason") // verification_failed | unresolvable | malformed
  detail     String?   @map("detail")
  /// Correlation-relevant headers only (request ids, hip id) — never Authorization.
  headers    Json      @map("headers")
  body       Json?     @map("body")
  receivedAt DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)
  resolvedBy String?   @map("resolved_by")

  @@index([receivedAt])
  @@index([reason, resolvedAt])
  @@map("quarantined_callbacks")
}

/// Inbox for domain events delivered by the clinical outbox dispatcher —
/// idempotency by event id (at-least-once delivery), processing state for the
/// M2 handlers (care-context linking etc., issue #114).
model EventInbox {
  id          String    @id @default(uuid()) @map("id") @db.Uuid
  /// The producer's event id — the idempotency key.
  eventId     String    @unique @map("event_id") @db.Uuid
  seq         BigInt    @map("seq")
  eventType   String    @map("event_type")
  tenantId    String    @map("tenant_id") @db.Uuid
  facilityId  String?   @map("facility_id") @db.Uuid
  payload     Json      @map("payload")
  occurredAt  DateTime  @map("occurred_at") @db.Timestamptz(6)
  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  status      String    @default("received") @map("status") // received | processed | failed | ignored
  attempts    Int       @default(0) @map("attempts")
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)
  error       String?   @map("error")

  @@index([status, receivedAt])
  @@index([eventType])
  @@map("event_inbox")
}

/// Care contexts built from encounter.closed events for ABHA-linked patients
/// (issue #114, ABDM M2). Protocol state only: which encounter is (being)
/// linked under which ABHA address — clinical content stays in clinical.
model CareContext {
  id             String    @id @default(uuid()) @map("id") @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  facilityId     String?   @map("facility_id") @db.Uuid
  patientId      String    @map("patient_id") @db.Uuid
  abhaAddress    String    @map("abha_address")
  /// Our care-context reference — the clinical encounter id.
  careContextRef String    @map("care_context_ref") @db.Uuid
  display        String    @map("display")
  status         String    @default("pending") @map("status") // pending | linked | failed
  /// Gateway transaction of the async link request (live path).
  linkTxnId      String?   @map("link_txn_id")
  gateway        String    @map("gateway") // abdm | mock
  error          String?   @map("error")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  linkedAt       DateTime? @map("linked_at") @db.Timestamptz(6)

  @@unique([tenantId, careContextRef])
  @@index([tenantId, patientId])
  @@index([status])
  @@map("care_contexts")
}

/// HIE-CM consent artefacts (issue #115, ABDM M2). The artefact — patient,
/// hiTypes, date range, expiry — is the authorization every HIP data
/// provision must be able to point back to; stored verbatim, never edited.
model ConsentArtefact {
  id           String    @id @default(uuid()) @map("id") @db.Uuid
  /// HIE-CM's consent artefact id.
  consentId    String    @unique @map("consent_id")
  tenantId     String    @map("tenant_id") @db.Uuid
  facilityId   String?   @map("facility_id") @db.Uuid
  abhaAddress  String    @map("abha_address")
  status       String    @map("status") // GRANTED | REVOKED | EXPIRED
  hiTypes      Json      @map("hi_types")
  fromDate     DateTime? @map("from_date") @db.Timestamptz(6)
  toDate       DateTime? @map("to_date") @db.Timestamptz(6)
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz(6)
  /// The full artefact as received — the audit/legal record.
  artefact     Json      @map("artefact")
  /// Whether the generic PatientConsent record was created in clinical.
  surfaced     Boolean   @default(false) @map("surfaced")
  surfaceError String?   @map("surface_error")
  receivedAt   DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, abhaAddress])
  @@index([status])
  @@map("consent_artefacts")
}
