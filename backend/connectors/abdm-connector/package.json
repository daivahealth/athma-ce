{
  "name": "@zeal/abdm-connector",
  "version": "0.1.0",
  "description": "ABDM connector service: owns the ABDM gateway edge (sessions, callbacks, correlation, tenant routing) for all tenants (ADR-0015)",
  "private": true,
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "predev": "npm run prisma:generate",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "build": "npm run prisma:generate && tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/main.js",
    "dev": "NODE_ENV=development ts-node -r tsconfig-paths/register --project tsconfig.build.json src/main.ts",
    "type-check": "npm run prisma:generate && tsc --noEmit -p tsconfig.build.json",
    "clean": "rm -rf dist generated",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@nestjs/common": "^10.2.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.2.0",
    "@nestjs/platform-express": "^10.2.0",
    "@prisma/client": "~6.19.0",
    "@zeal/config-client": "file:../../shared/config-client",
    "@zeal/contracts": "file:../../contracts",
    "@zeal/observability": "file:../../shared/observability",
    "@zeal/validators": "file:../../shared/validators",
    "axios": "^1.20.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^16.3.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "prisma": "~6.19.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "diagnostics": false
        }
      ]
    }
  }
}
